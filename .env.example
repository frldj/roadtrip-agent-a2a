# Agent listening ports (change if ports are already in use)
ROUTE_AGENT_PORT=9011
VEHICLE_AGENT_PORT=9012
ACCOMMODATION_AGENT_PORT=9013

# Agent URLs as seen by the orchestrator (update if ports changed above)
ROUTE_AGENT_URL=http://localhost:9011
VEHICLE_AGENT_URL=http://localhost:9012
ACCOMMODATION_AGENT_URL=http://localhost:9013

# Optional API keys — the system works without them (falls back to OSM/Overpass)
# Open Charge Map: enriched charging stop details (operator, connectors, kW)
# Free key at https://openchargemap.org/site/develop
OPEN_CHARGE_MAP_KEY=

# Google Places: accommodation with ratings and real price levels
# Free $200/month credit at https://console.cloud.google.com — enable "Places API"
GOOGLE_PLACES_KEY=
